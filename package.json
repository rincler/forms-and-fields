{
    "name": "forms-and-fields",
    "version": "1.1.2",
    "description": "A library for validating fields and submitting forms.",
    "keywords": [
        "form",
        "forms",
        "field",
        "fields",
        "validation",
        "validator",
        "validate"
    ],
    "main": "lib/index.js",
    "files": [
        "lib",
        "README.md",
        "LICENSE",
        "package.json"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rincler/forms-and-fields.git"
    },
    "author": "Dmitriy Romashov",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/rincler/forms-and-fields/issues"
    },
    "homepage": "https://github.com/rincler/forms-and-fields#readme",
    "dependencies": {
        "@babel/runtime": "^7.26.0",
        "validator": "^13.12.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.26.4",
        "@babel/core": "^7.26.0",
        "@babel/plugin-transform-runtime": "^7.25.9",
        "@babel/preset-env": "^7.26.0",
        "@testing-library/dom": "^10.4.0",
        "babelify": "^10.0.0",
        "browserify": "^17.0.1",
        "eslint": "^8.57.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.10.0",
        "eslint-plugin-prettier": "^5.2.1",
        "express": "^4.21.2",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "prettier": "3.4.2"
    },
    "scripts": {
        "build": "babel src --out-dir lib",
        "prepack": "npm run build",
        "lint": "eslint .",
        "sandbox": "npm run sandbox:build && npm run sandbox:start",
        "sandbox:build": "browserify sandbox/sandbox.js -o sandbox/bundle.js -t babelify --debug",
        "sandbox:start": "node sandbox/server.js",
        "test": "jest"
    }
}
