{
    "env": {
        "browser": true,
        "es6": true,
        "jest/globals": true
    },
    "extends": ["airbnb-base", "plugin:prettier/recommended",  "plugin:jest/recommended"],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "no-continue": ["off"],
        "prefer-destructuring": ["off"],
        "no-plusplus": ["off"]
    }
}
